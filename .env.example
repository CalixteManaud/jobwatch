# Copier ce fichier en .env (jamais commité) puis renseigner les valeurs.

# Application créée sur https://francetravail.io, autorisée sur l'API « Offres d'emploi v2 »
# (accès sur demande, identifiants valables un an)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Discord : Paramètres du salon → Intégrations → Webhooks → Copier l'URL du webhook
DISCORD_WEBHOOK_URL=

# --- Optionnel ---
# FT_AUTH_URL=https://authentification-partenaire.francetravail.io/connexion/oauth2/access_token
# STATE_PATH=./state/jobwatch.db
# OUT_DIR=./out
# CONFIG_PATH=./config.yaml
